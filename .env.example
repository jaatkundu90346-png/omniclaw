# OmniClaw Environment Configuration
# Copy this to .env and fill in your values

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Server
PORT=3147

# Security
# Set to true to require gateway token on all API requests
REQUIRE_API_AUTH=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Discord Bot
DISCORD_BOT_TOKEN=
